<launch>
  <group ns="robot1">
      <node name="map_server" pkg="map_server" type="map_server" args="$(find dispatch_control)/Map/ntuitive_align/2m/map.yaml"/>

      <node pkg="ntu_planner" type="reload_planning_controller.py" name="reload_planning_controller" output="screen"/>

      <!-- MBF (Move Base Flex) Node -->
      <node pkg="mbf_costmap_nav" type="mbf_costmap_nav" respawn="false" name="move_base_flex" output="screen">
        <rosparam file="$(find ntu_planner)/config/mbf_params.yaml" command="load" />
        <rosparam file="$(find ntu_planner)/config/costmap_common_params_global.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find ntu_planner)/config/costmap_common_params_local.yaml" command="load" ns="local_costmap" />
        
        <!-- Global Planner 配置 -->
        <rosparam file="$(find ntu_planner)/config/global_planner_params.yaml" command="load" ns="global_planner" />
        
        <!-- TEB Local Planner 配置 -->
        <rosparam file="$(find ntu_planner)/config/teb_local_planner_params_ackermann.yaml" command="load" ns="local_planner" />
        <rosparam file="$(find ntu_planner)/config/teb_local_planner_params_omnidirectional.yaml" command="load" ns="local_planner" />
        
        <!-- Recovery Behaviors 配置 -->
        <rosparam ns="clear_costmap_local">
          reset_distance: 5.0       # 清除局部代价地图的范围（米）
          affected_maps: local      # 影响的地图: local, global, both
        </rosparam>
        
        <rosparam ns="rotate_recovery">
          sim_granularity: 0.017    # 仿真粒度（弧度），约1度
          frequency: 20.0           # 控制频率（Hz）
          angular_speed: 0.1        # 降低角速度（默认0.4）
          max_rotational_vel: 0.1   # 限制最大速度
        </rosparam>
        
        <rosparam ns="clear_costmap_global">
          reset_distance: 5.0       # 清除全局代价地图的范围（米）
          affected_maps: both       # 同时清除全局和局部
        </rosparam>
        
        <remap from="cmd_vel" to="/base_cmd_vel"/>
      </node>

      <!-- MBF Legacy Relay: 使 MBF 兼容 move_base 的 simple goal 话题 -->
      <node pkg="mbf_costmap_nav" type="move_base_legacy_relay.py" name="move_base_legacy_relay" output="screen">
        <!-- 设置默认的全局规划器和局部控制器 -->
        <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
        <param name="base_local_planner" value="local_planner/TebLocalPlannerROS_Omnidirectiona"/>
      </node>

      <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">
        <remap from="cloud_in" to="/merged_pointcloud_sliced"/>
        <remap from="scan" to="/local_map_laserscan"/>
        <rosparam>
          target_frame: local_map  # 目标坐标系
          transform_tolerance: 0.01
          <!-- min_height: -0.2
          max_height: 1.5 -->
          min_height: 0.0
          max_height: 1.45
          angle_min: -3.14159  # -180度
          angle_max: 3.14159   # 180度
          angle_increment: 0.0087  # 0.5度
          scan_time: 0.1
          range_min: 0.1
          range_max: 10.0
          use_inf: true
          inf_epsilon: 1.0
        </rosparam>
      </node>
  </group>
</launch>
