<?xml version="1.0"?>
<package format="2">
  <name>ntu_planner</name>
  <version>0.0.0</version>
  <description>The ntu_planner package</description>

  <maintainer email="amov@todo.todo">amov</maintainer>


  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Dynamic Reconfigure -->
  <build_depend>dynamic_reconfigure</build_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>

  <!-- ROS 消息和基础包 -->
  <build_depend>costmap_2d</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>teb_local_planner</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>base_local_planner</build_depend>

  <!-- 系统依赖：CUDA, Eigen3, Fortran -->
  <depend>libcudart-dev</depend>
  <depend>libeigen3-dev</depend>
  <depend>gfortran</depend>
  <build_export_depend>costmap_2d</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>teb_local_planner</build_export_depend>
  <build_export_depend>tf</build_export_depend>
  <!-- MBF 和其他 ROS 包 -->
  <build_depend>sensor_msgs</build_depend>
  <build_depend>mbf_costmap_core</build_depend>
  <build_depend>mbf_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>visualization_msgs</build_depend>
  
  <!-- 运行时依赖 -->
  <exec_depend>costmap_2d</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>teb_local_planner</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>mbf_costmap_core</exec_depend>
  <exec_depend>mbf_msgs</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>base_local_planner</exec_depend>

  <export>
    <mbf_costmap_core plugin="${prefix}/custom_planner_plugin.xml" />
  </export>
</package>
